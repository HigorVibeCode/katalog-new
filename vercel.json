{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/technik/(.*)", "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Buechler-Glas-Technischer-Katalog.pdf\"" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
